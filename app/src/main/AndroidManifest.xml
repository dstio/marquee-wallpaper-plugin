<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A TV launcher plugin; it also runs where there is no leanback or touch screen. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".MarqueeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_marquee"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- Only a launcher holding BIND_WALLPAPER can bind it. -->
        <service
            android:name=".provider.MarqueeWallpaperService"
            android:exported="true"
            android:permission="ca.dstudio.atvlauncher.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="ca.dstudio.atvlauncher.wallpaper.SERVICE" />
            </intent-filter>
            <meta-data
                android:name="ca.dstudio.atvlauncher.wallpaper.INFO"
                android:resource="@xml/wallpaper_info" />
        </service>

        <!-- The pictures, read-only, for a launcher holding BIND_WALLPAPER; no grants. -->
        <provider
            android:name=".provider.MarqueeFiles"
            android:authorities="${applicationId}.wallpapers"
            android:exported="true"
            android:readPermission="ca.dstudio.atvlauncher.permission.BIND_WALLPAPER" />

        <!-- The settings, which a launcher opens from its plugin page. It reads nothing from the
             intent that starts it. BACK is handled as a key: the panel steps back through its own
             pages and lists before the screen closes. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Marquee.Settings" />
    </application>

</manifest>
